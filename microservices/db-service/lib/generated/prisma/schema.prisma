generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model BLOG {
  ID               Int       @id @default(autoincrement())
  BLOG_CREATE_TIME DateTime? @default(now()) @db.DateTime(0)
  BLOG_UPDATE_TIME DateTime? @default(now()) @db.DateTime(0)
  BLOG_TITLE       String?   @db.VarChar(255)
  BLOG_CONTENT     String?   @db.Text
  IS_DELETE        String?   @db.VarChar(255)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ENGLISH {
  ID          Int      @id @default(autoincrement())
  CONTENT     String   @db.VarChar(2555)
  CREATE_TIME DateTime @default(now()) @db.DateTime(0)
  UPDATE_TIME DateTime @default(now()) @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model VISIT_RECORDER {
  ID          Int      @id @default(autoincrement())
  IP          String?  @db.VarChar(255)
  CREATE_TIME DateTime @default(now()) @db.Timestamp(0)
}
