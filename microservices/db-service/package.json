{
    "version": "1.0.13",
    "name": "db-service",
    "author": {
        "name": "江建清",
        "email": "1810422805@qq.com"
    },
    "scripts": {
        "dev": "npx prisma db pull && npx prisma generate && node generate-structure.js && cross-env NODE_ENV=development pm2-runtime start ecosystem.config.js",
        "prod": "cross-env NODE_ENV=production pm2-runtime start ecosystem.config.js",
        "build": "rimraf dist && tsc --build tsconfig.json && copyfiles package.json dist",
        "start": "cross-env NODE_ENV=production pm2-runtime start ecosystem.config.js"
    },
    "dependencies": {
        "@prisma/client": "6.7.0",
        "amqplib": "^0.10.8",
        "express": "^5.1.0",
        "pm2": "^6.0.8",
        "prisma": "6.7.0",
        "safe-timers": "^1.1.0"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.0.3",
        "@types/response-time": "^2.3.9",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
